      }
    }
  },
  "attested_present_level": 2,
  "vuln_ladder": {
    "note": "worst open severity -> level. Absence of findings on a scanned target is a fact about that scan, not proof of no vulnerabilities, hence 4 not 5.",
    "no_findings": 4,
    "worst_low_or_medium": 3,
    "worst_high": 2,
    "worst_critical": 1,
    "no_scan": 0
  }
}
      "key": "6c",
      "rule": {
        "type": "attested_present"
      }
    },
    "people-v1:mfa": {
      "rubric": "people-v1",
      "key": "2a",
      "rule": {
        "type": "fraction_ladder",
        "path": "mfa.coverage_fraction",
        "ladder": [
          [
            0.99,
            4
          ],
          [
            0.9,
            3
          ],
          [
            0.5,
            2
          ],
          [
            1e-06,
            1
          ]
        ],
        "else": 0
      }
    },
    "people-v1:least-privilege": {
      "rubric": "people-v1",
      "key": "4a",
      "rule": {
        "type": "inverse_fraction_ladder",
        "path": "least-privilege.privileged_fraction",
        "ladder": [
          [
            0.05,
            4
          ],
          [
            0.1,
            3
          ],
          [
            0.25,
            2
          ],
          [
            0.5,
            1
          ]
        ],
        "else": 0
      }
    },
    "people-v1:jml": {
      "rubric": "people-v1",
      "key": "2b",
      "rule": {
        "type": "steps",
        "steps": [
          {
            "path": "jml.total_records",
            "gt": 0,
            "level": 1
          },
          {
            "path": "jml.disabled_or_suspended_still_present",
